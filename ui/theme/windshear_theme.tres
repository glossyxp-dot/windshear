; The kit styles. A control picks one of these in the Inspector, under
; Theme, Type Variation. The colours live here and not in the scenes, so
; changing one changes every screen that uses it.
WsHeading/base_type = &"Label"
WsHeading/colors/font_color = Color(0.29, 0.64, 1, 1)
WsHeading/font_sizes/font_size = 11
WsTitle/base_type = &"Label"

##
## The mouse is the camera. A player holding it is not holding a movement
## key, so the mouse cannot be the only route to an action.
##
## These tests hold that line:
##
## [br]- every action a player needs has at least one keyboard binding;
## [br]- no action is mouse-only;
## [br]- every action except the keyboard look pair also works on a pad;
## [br]- the camera rig actually reads the keyboard look actions.
##
## The map itself is generated by `tools/setup_input_map.gd`, because a
## hand-written `[input]` section in `project.godot` is a wall of
## `Object(InputEventKey, ...)` lines that nobody reviews.
extends "res://tests/ws_test.gd"

## The actions a player has to be able to reach from the keyboard.
const KEYBOARD_REQUIRED := [
	"move_left",
	"move_right",
	"jump",
	"slip",
	"mantle",
	"filament",
	"fire",
	"aim",
	"reload",
	"use_item",
	"cycle_weapon",
	"look_key_left",
	"look_key_right",
	"look_key_up",
	"look_key_down",
	"reset_to_checkpoint",
	"toggle_splits",
	"toggle_help",
]

## The actions that are keyboard-only by design: they are the keyboard's
## route to the camera, and the camera already has a stick.
const KEYBOARD_ONLY := [
	"look_key_left",
	"look_key_right",
	"look_key_up",
	"look_key_down",
]

## The camera rig.
const Rig := preload("res://addons/windshear/movement/camera_rig.gd")


func suite_name() -> String:
	return "the input map works without the mouse"


func run() -> void:
	_test_the_actions_exist()
	_test_every_action_has_a_key()
	_test_nothing_is_mouse_only()
	_test_the_pad_works_too()
	_test_the_camera_reads_the_keys()


## Every action in the list has to exist in the map.
func _test_the_actions_exist() -> void:
	heading("the actions exist")
	var missing: Array = []
	for action_name in KEYBOARD_REQUIRED:
		if not InputMap.has_action(action_name):
			missing.append(action_name)
	ok(missing.is_empty(), "every action is in the map (%s)" % ", ".join(missing))


## Every action has at least one keyboard binding.
func _test_every_action_has_a_key() -> void:
	heading("every action has a key")
	var keyless: Array = []
	for action_name in KEYBOARD_REQUIRED:
		if not InputMap.has_action(action_name):
			continue
		if not _has_key(action_name):
			keyless.append(action_name)
	ok(keyless.is_empty(),
		"every action can be pressed from the keyboard (%s)" % ", ".join(keyless))

	# The Filament is the one that used to be mouse-only, so it gets its own
	# line in the log. It is the tether, and a tether is a movement verb.
	ok(_has_key("filament"), "the filament is not mouse-only")


## No action may be reachable only through the mouse.
func _test_nothing_is_mouse_only() -> void:
	heading("nothing is mouse-only")
	var mouse_only: Array = []
	var all_actions: Array = []
	for action_name in InputMap.get_actions():
		if String(action_name).begins_with("ui_"):
			continue
		all_actions.append(action_name)

	for action_name in all_actions:
		if KEYBOARD_ONLY.has(action_name):
			continue
		if _has_mouse(action_name) and not _has_key(action_name) and not _has_pad(action_name):
			mouse_only.append(action_name)
	ok(mouse_only.is_empty(),
		"no action needs the mouse (%s)" % ", ".join(mouse_only))


## Every action except the keyboard look pair has a pad binding too.
func _test_the_pad_works_too() -> void:
	heading("the pad works too")
	var padless: Array = []
	for action_name in KEYBOARD_REQUIRED:
		if KEYBOARD_ONLY.has(action_name):
			continue
		if not InputMap.has_action(action_name):
			continue
		if not _has_pad(action_name):
			padless.append(action_name)
	ok(padless.is_empty(),
		"every action works on a controller (%s)" % ", ".join(padless))


## The camera rig has to read the keyboard look actions, or the keys do
## nothing at all.
func _test_the_camera_reads_the_keys() -> void:
	heading("the camera reads the keys")
	var source := FileAccess.get_file_as_string("res://addons/windshear/movement/camera_rig.gd")
	for action_name in KEYBOARD_ONLY:
		ok(source.contains(action_name), "the camera rig reads " + action_name)
	ok(source.contains("InputEventMouseMotion"), "the camera rig still reads the mouse")
	ok(source.contains("key_sensitivity"), "the camera rig has its own key rate")


## True when the action has a keyboard binding.
func _has_key(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventKey:
			return true
	return false


## True when the action has a mouse binding.
func _has_mouse(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventMouseButton:
			return true
	return false


## True when the action has a controller binding.
func _has_pad(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventJoypadButton or event is InputEventJoypadMotion:
			return true
	return false

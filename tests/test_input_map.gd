##
## The scheme is a decision, and a decision that nobody checks quietly stops
## being true.
##
## [codeblock]
## W / S    walk forward, walk back
## A / D    strafe left, strafe right
## Ctrl     slide
## Space    jump
## Q        ledge grab
## E        interact
## F        filament
## mouse    camera
## LMB      primary fire
## RMB      alt fire
## [/codeblock]
##
## The mouse does the camera and both triggers, and the keyboard never touches
## the camera. W and S walk along the camera's facing, A and D strafe across
## it, so the walk follows the view. These tests hold that line:
##
## [br]- every action except the two triggers and the stick look has a keyboard binding;
## [br]- the two triggers are on the mouse buttons they belong on;
## [br]- the keys are the keys the controls document promises;
## [br]- every action works on a controller too;
## [br]- the camera rig reads the mouse and the stick, and no key.
##
## The map is generated by `tools/setup_input_map.gd`. A hand-written
## `[input]` section in `project.godot` is a wall of
## `Object(InputEventKey, ...)` lines that nobody reviews.
extends "res://tests/ws_test.gd"

## The actions a player has to be able to reach from the keyboard.
const KEYBOARD_REQUIRED := [
	"move_forward",
	"move_back",
	"move_left",
	"move_right",
	"jump",
	"slip",
	"ledge_grab",
	"interact",
	"filament",
	"reload",
	"use_item",
	"cycle_weapon",
	"reset_to_checkpoint",
	"toggle_splits",
	"toggle_help",
]

## The two trigger actions live on the mouse. The mouse already handles the
## camera, so the triggers go with it.
const MOUSE_ACTIONS := [
	"primary_fire",
	"alt_fire",
]

## These four look actions belong to the right stick. The mouse is the other
## way to look, and there is no keyboard route at all.
const STICK_ACTIONS := [
	"look_left",
	"look_right",
	"look_up",
	"look_down",
]

## The camera rig.
const Rig := preload("res://addons/windshear/movement/camera_rig.gd")


func suite_name() -> String:
	return "the input map is the scheme we said"


func run() -> void:
	_test_the_actions_exist()
	_test_every_action_has_a_key()
	_test_the_keys_are_the_right_keys()
	_test_the_triggers_are_on_the_mouse()
	_test_the_pad_works_too()
	_test_the_camera_is_mouse_and_stick()


## Every action in the list has to exist in the map.
func _test_the_actions_exist() -> void:
	heading("the actions exist")
	var missing: Array = []
	for action_name in KEYBOARD_REQUIRED + MOUSE_ACTIONS + STICK_ACTIONS:
		if not InputMap.has_action(action_name):
			missing.append(action_name)
	ok(missing.is_empty(), "every action is in the map (%s)" % ", ".join(missing))


## Every action except the two triggers and the stick look has a keyboard
## binding.
func _test_every_action_has_a_key() -> void:
	heading("every action has a key")
	var keyless: Array = []
	for action_name in KEYBOARD_REQUIRED:
		if not InputMap.has_action(action_name):
			continue
		if not _has_key(action_name):
			keyless.append(action_name)
	ok(keyless.is_empty(),
		"every action can be pressed from the keyboard (%s)" % ", ".join(keyless))

	# The Filament used to be mouse-only, so it gets an assertion of its own.
	# It is the tether, and a tether is a movement verb.
	ok(_has_key("filament"), "the filament is not mouse-only")

	# The same holds for anything new that turns up in the map later. The
	# exceptions are the two triggers and the stick's look actions. Both are
	# deliberate, and both are listed above.
	var stray: Array = []
	for action_name in InputMap.get_actions():
		var action := String(action_name)
		if action.begins_with("ui_"):
			continue
		if MOUSE_ACTIONS.has(action) or STICK_ACTIONS.has(action):
			continue
		if not _has_key(action):
			stray.append(action)
	ok(stray.is_empty(),
		"nothing new in the map is missing a keyboard binding (%s)" % ", ".join(stray))


## The keys are the ones the controls document promises.
func _test_the_keys_are_the_right_keys() -> void:
	heading("the keys are the right keys")
	var expected := {
		"move_forward": KEY_W,
		"move_back": KEY_S,
		"move_left": KEY_A,
		"move_right": KEY_D,
		"jump": KEY_SPACE,
		"slip": KEY_CTRL,
		"ledge_grab": KEY_Q,
		"interact": KEY_E,
		"filament": KEY_F,
	}
	for action_name in expected.keys():
		ok(_has_keycode(action_name, expected[action_name]),
			"%s is on the key it should be on" % action_name)

	# Jump and slide are not on W and S any more. WASD is the walk cluster.
	ok(not _has_keycode("jump", KEY_W), "w is not jump any more")
	ok(not _has_keycode("slip", KEY_S), "s is not slide any more")

	# The camera used to have a keyboard route on the arrows. It doesn't any
	# more, and a stray arrow binding would quietly bring it back.
	var arrow_users: Array = []
	for action_name in InputMap.get_actions():
		var action := String(action_name)
		if action.begins_with("ui_"):
			continue
		if _has_keycode(action, KEY_LEFT) or _has_keycode(action, KEY_RIGHT) \
				or _has_keycode(action, KEY_UP) or _has_keycode(action, KEY_DOWN):
			arrow_users.append(action)
	ok(arrow_users.is_empty(), "no action claims the arrows (%s)" % ", ".join(arrow_users))


## The two triggers are on the mouse buttons.
func _test_the_triggers_are_on_the_mouse() -> void:
	heading("the triggers are on the mouse")
	ok(_has_mouse_button("primary_fire", MOUSE_BUTTON_LEFT),
		"the left mouse button is the primary fire")
	ok(_has_mouse_button("alt_fire", MOUSE_BUTTON_RIGHT),
		"the right mouse button is the alt fire")


## Every action has a controller binding too.
func _test_the_pad_works_too() -> void:
	heading("the pad works too")
	var padless: Array = []
	for action_name in KEYBOARD_REQUIRED + MOUSE_ACTIONS + STICK_ACTIONS:
		if not InputMap.has_action(action_name):
			continue
		if not _has_pad(action_name):
			padless.append(action_name)
	ok(padless.is_empty(),
		"every action works on a controller (%s)" % ", ".join(padless))


## The camera rig reads the mouse and the stick, and no keyboard look at all.
func _test_the_camera_is_mouse_and_stick() -> void:
	heading("the camera is mouse and stick")
	var source := FileAccess.get_file_as_string("res://addons/windshear/movement/camera_rig.gd")
	ok(source.contains("InputEventMouseMotion"), "the camera rig reads the mouse")
	for action_name in STICK_ACTIONS:
		ok(source.contains(action_name), "the camera rig reads " + action_name)
	ok(not source.contains("look_key_"), "the camera rig has no keyboard look")
	ok(not source.contains("key_sensitivity"), "the camera rig has no key rate")


## True when the action has a keyboard binding.
func _has_key(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventKey:
			return true
	return false


## True when the action has a binding on this physical key.
func _has_keycode(action_name: String, keycode: Key) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventKey and event.physical_keycode == keycode:
			return true
	return false


## True when the action has a mouse binding.
func _has_mouse(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventMouseButton:
			return true
	return false


## True when the action has this mouse button.
func _has_mouse_button(action_name: String, button: MouseButton) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventMouseButton and event.button_index == button:
			return true
	return false


## True when the action has a controller binding.
func _has_pad(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventJoypadButton or event is InputEventJoypadMotion:
			return true
	return false

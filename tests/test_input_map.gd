##
## The scheme is a decision, and a decision that nobody checks is a decision
## that quietly stops being true.
##
## The mouse does the camera and the two triggers, because the mouse is
## already in the hand that is doing the camera. Everything else is on the
## keyboard. These tests hold that line:
##
## [br]- every action except the two triggers has a keyboard binding;
## [br]- the two triggers are on the mouse buttons they are supposed to be on;
## [br]- the keys are the keys the controls document says they are;
## [br]- every action works on a controller too;
## [br]- the camera rig actually reads the keyboard look actions.
##
## The map itself is generated by `tools/setup_input_map.gd`, because a
## hand-written `[input]` section in `project.godot` is a wall of
## `Object(InputEventKey, ...)` lines that nobody reviews.
extends "res://tests/ws_test.gd"

## The actions a player has to be able to reach from the keyboard.
const KEYBOARD_REQUIRED := [
	"move_left",
	"move_right",
	"jump",
	"slip",
	"ledge_grab",
	"interact",
	"filament",
	"reload",
	"use_item",
	"cycle_weapon",
	"look_key_left",
	"look_key_right",
	"look_key_up",
	"look_key_down",
	"reset_to_checkpoint",
	"toggle_splits",
	"toggle_help",
]

## The two actions that live on the mouse. The mouse is doing the camera
## anyway, so the triggers go with it.
const MOUSE_ACTIONS := [
	"primary_fire",
	"alt_fire",
]

## The stick's look actions. The keyboard gets its own pair, below, and the
## gamepad gets these.
const STICK_ACTIONS := [
	"look_left",
	"look_right",
	"look_up",
	"look_down",
]

## The keyboard look actions are the keyboard's route to the camera, and the
## camera already has a stick.
const KEYBOARD_ONLY := [
	"look_key_left",
	"look_key_right",
	"look_key_up",
	"look_key_down",
]

## The camera rig.
const Rig := preload("res://addons/windshear/movement/camera_rig.gd")


func suite_name() -> String:
	return "the input map is the scheme we said"


func run() -> void:
	_test_the_actions_exist()
	_test_every_action_has_a_key()
	_test_the_keys_are_the_right_keys()
	_test_the_triggers_are_on_the_mouse()
	_test_the_pad_works_too()
	_test_the_camera_reads_the_keys()


## Every action in the list has to exist in the map.
func _test_the_actions_exist() -> void:
	heading("the actions exist")
	var missing: Array = []
	for action_name in KEYBOARD_REQUIRED + MOUSE_ACTIONS:
		if not InputMap.has_action(action_name):
			missing.append(action_name)
	ok(missing.is_empty(), "every action is in the map (%s)" % ", ".join(missing))


## Every action except the two triggers has at least one keyboard binding.
func _test_every_action_has_a_key() -> void:
	heading("every action has a key")
	var keyless: Array = []
	for action_name in KEYBOARD_REQUIRED:
		if not InputMap.has_action(action_name):
			continue
		if not _has_key(action_name):
			keyless.append(action_name)
	ok(keyless.is_empty(),
		"every action can be pressed from the keyboard (%s)" % ", ".join(keyless))

	# The Filament is the one that used to be mouse-only, so it gets its own
	# line in the log. It is the tether, and a tether is a movement verb.
	ok(_has_key("filament"), "the filament is not mouse-only")

	# And the same holds for anything new that turns up in the map later.
	# The exceptions are the two triggers and the stick's look actions, both
	# of which are deliberate and both of which are listed above.
	var stray: Array = []
	for action_name in InputMap.get_actions():
		var action := String(action_name)
		if action.begins_with("ui_"):
			continue
		if MOUSE_ACTIONS.has(action) or STICK_ACTIONS.has(action):
			continue
		if not _has_key(action):
			stray.append(action)
	ok(stray.is_empty(),
		"nothing new in the map is missing a keyboard binding (%s)" % ", ".join(stray))


## The keys are the ones the controls document promises.
func _test_the_keys_are_the_right_keys() -> void:
	heading("the keys are the right keys")
	var expected := {
		"move_left": KEY_A,
		"move_right": KEY_D,
		"jump": KEY_SPACE,
		"slip": KEY_CTRL,
		"ledge_grab": KEY_Q,
		"interact": KEY_E,
		"filament": KEY_F,
	}
	for action_name in expected.keys():
		ok(_has_keycode(action_name, expected[action_name]),
			"%s is on the key it should be on" % action_name)

	# W and S tilt the camera, because the game plays on one plane and there
	# is no forward to walk into.
	ok(_has_keycode("look_key_up", KEY_W), "W tilts the camera up")
	ok(_has_keycode("look_key_down", KEY_S), "S tilts the camera down")
	ok(_has_keycode("look_key_left", KEY_LEFT), "the left arrow turns the camera")
	ok(_has_keycode("look_key_right", KEY_RIGHT), "the right arrow turns the camera")


## The two triggers are on the mouse buttons.
func _test_the_triggers_are_on_the_mouse() -> void:
	heading("the triggers are on the mouse")
	ok(_has_mouse_button("primary_fire", MOUSE_BUTTON_LEFT),
		"the left mouse button is the primary fire")
	ok(_has_mouse_button("alt_fire", MOUSE_BUTTON_RIGHT),
		"the right mouse button is the alt fire")


## Every action has a controller binding too.
func _test_the_pad_works_too() -> void:
	heading("the pad works too")
	var padless: Array = []
	for action_name in KEYBOARD_REQUIRED + MOUSE_ACTIONS:
		if KEYBOARD_ONLY.has(action_name):
			continue
		if not InputMap.has_action(action_name):
			continue
		if not _has_pad(action_name):
			padless.append(action_name)
	ok(padless.is_empty(),
		"every action works on a controller (%s)" % ", ".join(padless))


## The camera rig has to read the keyboard look actions, or the keys do
## nothing at all.
func _test_the_camera_reads_the_keys() -> void:
	heading("the camera reads the keys")
	var source := FileAccess.get_file_as_string("res://addons/windshear/movement/camera_rig.gd")
	for action_name in KEYBOARD_ONLY:
		ok(source.contains(action_name), "the camera rig reads " + action_name)
	ok(source.contains("InputEventMouseMotion"), "the camera rig still reads the mouse")
	ok(source.contains("key_sensitivity"), "the camera rig has its own key rate")


## True when the action has a keyboard binding.
func _has_key(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventKey:
			return true
	return false


## True when the action has a binding on this physical key.
func _has_keycode(action_name: String, keycode: Key) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventKey and event.physical_keycode == keycode:
			return true
	return false


## True when the action has a mouse binding.
func _has_mouse(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventMouseButton:
			return true
	return false


## True when the action has this mouse button.
func _has_mouse_button(action_name: String, button: MouseButton) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventMouseButton and event.button_index == button:
			return true
	return false


## True when the action has a controller binding.
func _has_pad(action_name: String) -> bool:
	for event in InputMap.action_get_events(action_name):
		if event is InputEventJoypadButton or event is InputEventJoypadMotion:
			return true
	return false

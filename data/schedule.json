    "gate_state_values": [
      "open",
      "closed",
      "cycling"
    ],
    "window_semantics": "Window start_frame is inclusive and end_frame is exclusive. A null end_frame is unbounded.",
    "cycle_resolution": "For a cycling gate, local_frame = (global_schedule_frame + phase_offset_frames) mod cycle_period_frames. The window containing local_frame determines the actual state. A non-cycling gate uses its single window directly.",
    "fallback_state": "closed",
    "reference": "A RegulationGate node references the matching gate_id. The section_id field is repeated for validation against data/sections/index.json."

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

; The PSX amount and the affine-texture toggle. These are global shader
; uniforms: every material that uses ws_psx.gdshader reads them, so the
; settings slider changes the whole game without touching a material.
; See addons/windshear/render/ws_psx.gd.
psx_amount={
"type": "float",
"value": 1.0
}
psx_affine={
"type": "float",
"value": 0.0
}

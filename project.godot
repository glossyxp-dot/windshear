; WindShear — Godot project configuration
; SPDX-License-Identifier: GPL-2.0-or-later
;
; Engine pin: Godot 4.7.2 (see TECH_SPEC.md §9).
; The [input] section is generated by tools/setup_input_map.gd — re-run it
; instead of hand-editing, so the key codes stay consistent.
;
; Controls: W/S walk forward and back, A/D strafe, Ctrl slides and Space
; jumps. Q grabs a ledge, E interacts and F throws the filament. LMB is
; primary fire and RMB is alt fire. The mouse controls the camera and both
; triggers, and nothing on the keyboard touches it. Movement is
; camera-relative, so forward is wherever you are looking.

config_version=5

[application]

config/name="WindShear"
config/description="A cinematic 3D speed-and-precision platformer set in a city whose wind is regulated."
config/version="0.1.0-alpha"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

WsGame="*res://addons/windshear/core/ws_game.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
; 960x540 is exactly 2x the internal 480x270 buffer, so every internal
; pixel lands on a clean 2x2 block and the nearest-neighbour upscale
; stays perfectly even. 1440x810 (3x) and 1920x1080 (4x) work the same
; way. 1280x720 is not one of them -- 480x270 -> 1280x720 is 2.67x, so
; the last row and column of pixels get squeezed.
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

